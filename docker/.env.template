# 容器可选环境变量（全部可留空：留空时使用 server.py 中的默认值）
# 注意：注释必须单独一行，不要写在 = 后面；load_env() 不会剥离行内注释。
# 留空 = 容器随机生成并写入 /app/.env（重开容器会变）；默认不再打印到日志
MCP_TOKEN=
# 1 = 在容器日志中打印 MCP_TOKEN / 管理员口令（仅隔离环境使用）
MCP_PRINT_SECRETS=0
# 1 = 强制 OAuth PKCE S256（默认）；老客户端不发送 challenge 时才设为 0
MCP_OAUTH_REQUIRE_PKCE=1
# 仅在网关/后台位于可信反向代理之后才设为 1，否则客户端可伪造 X-Forwarded-For
MCP_TRUST_PROXY=0
ADMIN_TRUST_PROXY=0
# 额外允许的 git 子命令（逗号分隔）；未知子命令默认拒绝，防止 alias 隐藏删除操作
# 制品已内置 git-lfs 并完成系统级初始化，带 LFS pre-push 钩子的仓库无需额外安装
MCP_GIT_EXTRA_SUBCOMMANDS=

# 容器内没有宿主机 /etc/gitconfig：不配置身份时 git_commit 会失败。
# CNB 等强制提交签名的平台，作者身份必须与令牌用户一致。
GIT_USER_NAME=
GIT_USER_EMAIL=
# 凭据文件路径；留空时自动探测 /root/.git-credentials（建议只读挂载，勿提交到仓库）
GIT_CREDENTIALS_FILE=
MCP_PORT=8765
MCP_BIND=127.0.0.1
MCP_WORKDIR=/workspace
# v1.1 默认管理员模式：留空 = 放行全部日常管理命令（apt / pip / docker / git ...）。
# 该变量现在只是「可选的收紧开关」，绝不要填成过窄白名单；Git 删除、毁灭级
# 指令、破坏性 confirm 门与全量审计在留空时依然全部生效。
MCP_ALLOWED_PREFIXES=
MCP_DENY_PREFIXES=
MCP_REQUIRE_CONFIRM=
# 单次命令输出上限（字符），防止超大输出撑爆 MCP 响应
MCP_MAX_OUTPUT_BYTES=2000000
# 二进制分片的默认上限（字节）；签名下载链接不受此限制（支持 Range 流式读取）
MCP_FILE_CHUNK_BYTES=1048576
# 受管文件根目录：所有上传/下载路径 resolve() 后必须位于此目录内
MCP_FILE_ROOT=/data/files
# 长任务日志目录（持久卷）；重启后仍可读
MCP_TASK_LOG_DIR=/data/audit/task-logs
# 签名下载链接的绝对基址，填写公网 HTTPS 域名（如 https://mcp.example.com）。
# 留空时回落到本次请求 Host / 本机端口，仅适合本机 curl 验证。
MCP_PUBLIC_BASE_URL=
# 签名密钥；留空时回落到 MCP_TOKEN。两进程必须看到同一个值。
MCP_FILE_SIGNING_SECRET=
# 0 = 默认不挂载 /var/run/docker.sock。设为 1 必须同时叠加
# docker-compose.host-docker.yml；该授权等价于宿主机 root。
MCP_DOCKER_SOCKET=0
# 命名 Cloudflare 隧道令牌（固定 URL）；留空则用 quick tunnel（随机 URL）
CF_TUNNEL_TOKEN=

# 检索功能：零密钥即可使用，以下均为可选调优项
MCP_SEARCH_TIMEOUT=10
MCP_SEARCH_MAX_RESULTS=8
MCP_SEARCH_MAX_BYTES=2000000
MCP_SEARCH_RETRIES=1
MCP_SEARCH_CACHE_TTL=300
MCP_SEARCH_ARXIV_MIN_INTERVAL=3
# 礼貌池邮箱：OpenAlex / CrossRef / NCBI / Unpaywall 用它提升额度，环境变量转储中自动脱敏
MCP_SEARCH_MAILTO=
# 默认网页搜索 provider（逗号分隔）：hn,stackexchange,github,searxng,tavily
MCP_SEARCH_WEB_PROVIDERS=hn,stackexchange
# 自建 SearXNG 地址（可选），例如 http://searxng:8080
MCP_SEARCH_SEARXNG_URL=
# Tavily 免费额度密钥（可选）；变量名含 KEY，会被自动脱敏
MCP_SEARCH_TAVILY_KEY=
# 页面正文抓取默认关闭；开启后有 SSRF 与提示注入风险，请配合下方白名单使用
MCP_SEARCH_FETCH_ENABLED=0
MCP_SEARCH_FETCH_MAX_CHARS=8000
# 允许抓取的主机白名单（逗号分隔）；留空表示允许任意公网 HTTPS 主机
MCP_SEARCH_FETCH_ALLOW_HOSTS=

# ---------------- MCP Admin Dashboard ----------------
# 使用方式：cp docker/.env.template .env（Compose 读取项目根目录的 .env）
# Admin Web 使用独立管理员账号，绝不能用 MCP_TOKEN 登录后台。
ADMIN_USERNAME=admin
# 镜像默认 admin（留空也回落为 admin），部署时用 -e ADMIN_PASSWORD=强口令 覆盖；
# 生效口令仍以 600 权限写入 audit-data 卷的 .admin_password，默认不打印到日志
ADMIN_PASSWORD=admin
# 留空 = 容器重启后旧会话自动失效（更安全）
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
# TOTP Base32 密钥（可选 MFA）；留空关闭
ADMIN_TOTP_SECRET=
# 通过 HTTPS 域名访问后台时设为 1（Cookie 仅走 HTTPS）
ADMIN_COOKIE_SECURE=0
# 后台默认只绑定宿主机 127.0.0.1，这里只改本机端口
ADMIN_HOST_PORT=8788
# CNB / 云平台端口预览需设为 0.0.0.0；开放前务必设置强 ADMIN_PASSWORD 并开启 MFA
ADMIN_BIND_HOST=127.0.0.1

# ---------------- 审计存储与保留策略 ----------------
# 默认 SQLite WAL；启用 postgres profile 时填写 postgresql://user:pass@postgres:5432/db
AUDIT_DB_DSN=
# 1 = 审计存储不可用时拒绝高风险工具；0 = 降级放行并缓冲（不中断科研任务）
AUDIT_STRICT=0
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_DB_MB=512
AUDIT_BACKUP_KEEP=7
AUDIT_BACKUP_ENABLED=1
AUDIT_MAINTENANCE_INTERVAL=300
AUDIT_MAX_FIELD_CHARS=32768

# ---------------- 可选 HTTPS 入口 ----------------
# 启用 cloudflared profile 时设为 1，避免网关内置 quick tunnel 重复暴露
MCP_TUNNEL_DISABLED=0
MCP_UPSTREAM_URL=http://mcp-gateway:8765
# 命名隧道令牌见上方 CF_TUNNEL_TOKEN（固定 HTTPS 域名；留空则 quick tunnel 随机域名）

# ---------------- 可选 PostgreSQL profile ----------------
# 启用 postgres profile 前必须改成强口令；默认值仅供本地演示
AUDIT_PG_USER=mcp_audit
AUDIT_PG_PASSWORD=change-me
AUDIT_PG_DB=mcp_audit
