# 容器可选环境变量（全部可留空：留空时使用 server.py 中的默认值）
# 注意：注释必须单独一行，不要写在 = 后面；load_env() 不会剥离行内注释。
# 留空 = 容器随机生成并打印到日志（重开容器会变）
MCP_TOKEN=
MCP_PORT=8765
MCP_BIND=127.0.0.1
MCP_WORKDIR=/workspace
MCP_ALLOWED_PREFIXES=
MCP_DENY_PREFIXES=
MCP_REQUIRE_CONFIRM=
# 命名 Cloudflare 隧道令牌（固定 URL）；留空则用 quick tunnel（随机 URL）
CF_TUNNEL_TOKEN=

# ---------------- OAuth 2.1 加固 ----------------
# 默认要求 redirect_uri 与 DCR 注册值精确匹配，且强制 PKCE S256。
# 下面两个开关只用于兼容旧客户端：开启会放宽回调匹配 / 取消 PKCE，
# 显著提高授权码被劫持的风险，生产环境务必保持 0。
OAUTH_ALLOW_ANY_REDIRECT=0
OAUTH_ALLOW_NO_PKCE=0
# 签发的 OAuth 令牌有效期（秒），默认 30 天；过期后中间件拒绝并清理
MCP_OAUTH_TOKEN_TTL=2592000

# ---------------- 健康接口与内部指标令牌 ----------------
# /health 公开且只返回 status/service/uptime_seconds/audit.healthy；
# /health/details 需 Bearer 或这里的内部只读令牌，返回工具数与容器指标。
# 留空 = 网关在共享卷生成 /data/audit/.metrics_token（权限 600，重启不变）。
# 该令牌只允许访问 /health/details，绝不是 MCP_TOKEN，不要交给任何 agent。
GATEWAY_METRICS_TOKEN=

# 检索功能：零密钥即可使用，以下均为可选调优项
MCP_SEARCH_TIMEOUT=10
MCP_SEARCH_MAX_RESULTS=8
MCP_SEARCH_MAX_BYTES=2000000
MCP_SEARCH_RETRIES=1
MCP_SEARCH_CACHE_TTL=300
MCP_SEARCH_ARXIV_MIN_INTERVAL=3
# 礼貌池邮箱：OpenAlex / CrossRef / NCBI / Unpaywall 用它提升额度，环境变量转储中自动脱敏
MCP_SEARCH_MAILTO=
# 默认网页搜索 provider（逗号分隔）：hn,stackexchange,github,searxng,tavily
MCP_SEARCH_WEB_PROVIDERS=hn,stackexchange
# 自建 SearXNG 地址（可选），例如 http://searxng:8080
MCP_SEARCH_SEARXNG_URL=
# Tavily 免费额度密钥（可选）；变量名含 KEY，会被自动脱敏
MCP_SEARCH_TAVILY_KEY=
# 页面正文抓取默认关闭；开启后有 SSRF 与提示注入风险，请配合下方白名单使用
MCP_SEARCH_FETCH_ENABLED=0
MCP_SEARCH_FETCH_MAX_CHARS=8000
# 允许抓取的主机白名单（逗号分隔）；留空表示允许任意公网 HTTPS 主机
MCP_SEARCH_FETCH_ALLOW_HOSTS=
# 一次解析并校验全部 IP、连接时固定 IP（TLS SNI 仍按原主机名），防 DNS rebinding。
# 私网放行已收窄：仅 MCP_SEARCH_SEARXNG_URL 中显式配置的主机可豁免，
# 不是「任意内网地址自动放行」；重定向逐跳重校验。默认开启。
MCP_SEARCH_PIN_DNS=1

# ---------------- MCP Admin Dashboard ----------------
# 使用方式：cp docker/.env.template .env（Compose 读取项目根目录的 .env）
# Admin Web 使用独立管理员账号，绝不能用 MCP_TOKEN 登录后台。
ADMIN_USERNAME=admin
# 留空 = 首次启动自动生成，持久化到 audit-data 卷（重启不变），并打印到容器日志
ADMIN_PASSWORD=
# 留空 = 容器重启后旧会话自动失效（更安全）
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
# 后台并发会话上限：超出时自动撤销最旧的活跃会话；CSRF 双提交 Cookie 始终启用。
ADMIN_MAX_SESSIONS=8
# TOTP Base32 密钥（可选 MFA）；留空关闭
ADMIN_TOTP_SECRET=
# 通过 HTTPS 域名访问后台时设为 1（Cookie 仅走 HTTPS）
ADMIN_COOKIE_SECURE=0
# 后台默认只绑定宿主机 127.0.0.1，这里只改本机端口
ADMIN_HOST_PORT=8788
# CNB / 云平台端口预览需设为 0.0.0.0；开放前务必设置强 ADMIN_PASSWORD 并开启 MFA
ADMIN_BIND_HOST=127.0.0.1

# ---------------- 审计存储与保留策略 ----------------
# 默认 SQLite WAL；启用 postgres profile 时填写 postgresql://user:pass@postgres:5432/db
AUDIT_DB_DSN=
# 1 = 无法确认调用记录已持久化时拒绝高风险工具（读回 RECEIVED 行确认）；
# 0 = 降级放行并缓冲（不中断科研任务），为默认值。
AUDIT_STRICT=0
# 审计采集层导入失败时的启动策略：默认 0 = 醒目告警并降级（保持既有行为）。
# 设为 1 时，除非同时显式设置 AUDIT_ALLOW_UNAUDITED=1，否则拒绝以无审计模式启动。
# AUDIT_ALLOW_UNAUDITED=1 必须由运维明确承担「调用无审计」风险，不建议长期开启。
AUDIT_REQUIRED=0
AUDIT_ALLOW_UNAUDITED=0
# 写库失败时的磁盘持久化缓冲（0600 JSONL + fsync，位于审计数据卷 spool/）。
# 默认开启；0 = 显式关闭并只保留内存缓冲（重启会丢事件，严格模式会告警）。
AUDIT_SPOOL_ENABLED=1
# 单个 spool 文件大小上限（MB）与轮转保留文件数，避免故障期间无限增长。
AUDIT_SPOOL_MAX_MB=64
AUDIT_SPOOL_MAX_FILES=4
# OAuth 客户端/授权码/令牌写入穿透审计库；磁盘只存 SHA-256 摘要。默认开启。
OAUTH_PERSIST_ENABLED=1
# 归档保留天数：覆盖 tool_calls 及所有事件 / 子表 / 过期会话，配置表不清理
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_DB_MB=512
# 归档分批大小（100..5000）；先落盘核验再按主键精确删除，循环至无残留
AUDIT_ARCHIVE_BATCH=1000
AUDIT_BUFFER_MAX=1000
# 客户端会话空闲 / 令牌有效期（秒），用于活跃客户端统计
MCP_SESSION_TTL=3600
AUDIT_BACKUP_KEEP=7
AUDIT_BACKUP_ENABLED=1
AUDIT_MAINTENANCE_INTERVAL=300
AUDIT_MAX_FIELD_CHARS=32768

# ---------------- 论文库 / 合法 OA PDF 下载 ----------------
# 保存目录（应位于持久化卷内）；下载与解析全程流式，不把正文写入审计库。
MCP_PAPER_DIR=/workspace/research/papers
# 单篇 PDF 大小上限（MB），超过即失败并给出原因。
MCP_PAPER_MAX_MB=64
# 批量下载有界并发（1..8）；各来源仍有最小请求间隔与 429 退避。
MCP_DOWNLOAD_CONCURRENCY=3
# PDF 按页文本缓存目录；OCR 为可选能力，默认不安装、不调用。
MCP_PAPER_TEXT_CACHE_DIR=/tmp/mcp_paper_text
# 合法 OA 主机白名单之外追加自建机构镜像（逗号分隔）。生产请勿放宽到任意来源。
MCP_PAPER_EXTRA_HOSTS=
# 仅离线测试/自建内网 OA 服务可设为 1；生产默认 0（只允许 https 官方来源）。
MCP_PAPER_ALLOW_PRIVATE=0
# 自建 SearXNG profile：docker compose --profile search up -d 后设置
# MCP_SEARCH_SEARXNG_URL=http://searxng:8080 与
# MCP_SEARCH_WEB_PROVIDERS=hn,stackexchange,searxng。软件免费不等于上游可达，
# 上游连通性必须在部署环境实测，后台不自动探测、不虚构可达性。
# 设为随机长字符串；留空时 SearXNG 仍可启动，但生产环境必须显式配置。
# 注意：searxng/settings.yml 以 :ro 挂载，若镜像入口无法用该环境变量覆盖
# secret_key，请改为挂载自带真实密钥的 searxng/settings.local.yml（已 gitignore）。
SEARXNG_SECRET=

# ---------------- 访问模式与双执行后端 ----------------
# 默认 full_admin：不启用路径/shell 白名单，管理员拥有执行环境内完整管理能力。
# restricted 为兼容模式，会启用 MCP_ALLOWED_PREFIXES 命令前缀白名单。
MCP_ACCESS_MODE=full_admin
# 灾难级正则与破坏性确认门只是「辅助保护，不是安全边界」；1=保持原有行为。
MCP_DANGER_GUARD=1
# 重大破坏性操作的可选独立确认；默认 0（仅需 confirm=true）。
MCP_INDEPENDENT_CONFIRM=0
# 默认执行后端：container（容器内）或 host（经授权 Host Agent）。
MCP_EXEC_BACKEND=container
# Host Agent：仅 Unix Socket（0600）+ HMAC，不监听 TCP 端口。
# 真实宿主权限必须由用户在宿主机自行部署并挂载授权目录，网关不自动提权。
MCP_HOST_AGENT_TOKEN=
MCP_HOST_AGENT_SOCKET=/var/run/mcp-host-agent/agent.sock
MCP_HOST_AGENT_ROOTS=/workspace
MCP_HOST_AGENT_HOST_DIR=./workspace

# ---------------- 通用分块 / Range 文件传输 ----------------
# 网关侧传输根目录（应位于持久化卷内）；上传/下载全程流式，不转 Base64。
MCP_TRANSFER_DIR=/workspace/transfers
# 单文件大小上限（MB）；超限返回 413 并删除临时分片。
TRANSFER_MAX_MB=256
# 签名下载链接密钥。网关侧留空时回落到 MCP_TOKEN；管理后台的
# /api/transfers/link 在留空时会直接拒绝签发，避免用弱默认密钥。
# 生产建议单独设置，且不复用 MCP_TOKEN。
MCP_TRANSFER_SECRET=
# 默认 0：只允许公网 https 来源；仅本地离线测试可设为 1。
MCP_TRANSFER_ALLOW_PRIVATE=0
# 任务日志目录（逐行脱敏、0600），与 task_state 持久化元数据分开存放。
MCP_TASK_LOG_DIR=/data/audit/task-logs

# ---------------- 可选 HTTPS 入口 ----------------
# 启用 cloudflared profile 时设为 1，避免网关内置 quick tunnel 重复暴露
MCP_TUNNEL_DISABLED=0
MCP_UPSTREAM_URL=http://mcp-gateway:8765
# 命名隧道令牌见上方 CF_TUNNEL_TOKEN（固定 HTTPS 域名；留空则 quick tunnel 随机域名）

# ---------------- 镜像版本（可选） ----------------
# 自建/固定版本镜像，Compose 各服务共用；留空或注释掉则使用 :latest。
# MCP_IMAGE=ghcr.io/ninaawa/cnb-mcp-gateway:latest

# ---------------- 可选 PostgreSQL profile ----------------
AUDIT_PG_USER=mcp_audit
AUDIT_PG_PASSWORD=change-me
AUDIT_PG_DB=mcp_audit

# ---------------- 内部固定变量（由 Compose 设置，勿在 .env 覆盖） ----------------
# 以下变量被 server.py / gateway/ 读取，但属于部署内部约定：Compose 直接写入
# 容器环境且指向共享卷，随意覆盖会导致网关与后台读到不同的库或指标令牌。
# 如需变更请同时修改 docker-compose.yml 中所有引用该值的服务。
#   AUDIT_DB_PATH=/data/audit/audit.db
#   AUDIT_EXPORT_DIR=/data/audit/exports
#   GATEWAY_URL=http://mcp-gateway:8765
#   GATEWAY_METRICS_TOKEN_FILE=/data/audit/.metrics_token
#   ADMIN_BIND=0.0.0.0 / ADMIN_PORT=8788（宿主绑定由 ADMIN_BIND_HOST / ADMIN_HOST_PORT 控制）
#   MCP_SERVICE_ROLE=<由各服务的 Compose 环境段指定：gateway / admin-web / maintenance / host-agent / cloudflared>
#   MCP_UPSTREAM_URL / MCP_TASK_LOG_DIR 已可由上方同名变量覆盖
# 仅 run.sh 单容器脚本读取 MCP_WORKDIR_MOUNT，Compose 部署使用固定绑定挂载 ./workspace。
