# CNB MCP Gateway v1.1 — 部署配置示例（全部为占位/空值，无任何真实秘密）
# 注意：只有 GitHub main 已合并 v1.1；CNB main 仍是旧提交 9266f9f，不含本文件与 scripts/。
#       只能用 CNB 时请改：git clone -b feat/mcp-v1.1 https://cnb.cool/webgamer-2026/cnb-mcp-gateway.git
# 傻瓜式一键部署（Docker / Compose；完成后终端直接打印全部连接信息）：
#   DEST=/workspace/mcp-gateway-v11; { [ -d "$DEST/.git" ] && git -C "$DEST" pull --ff-only || git clone https://github.com/NinaAWA/cnb-mcp-gateway.git "$DEST"; } && cd "$DEST" && cp .env.example .env && docker compose up -d --build
#   bash scripts/show-config.sh   # 打印连接信息；尚未合并该脚本的 main 见 README 的内联兜底命令
# 完整版（含前置校验与就绪等待）见 README.md / README.zh-CN.md 的部署章节。
# 原生 Linux / systemd（能力最完整，需真实 systemd 与 root；当前已是 root 时无需 sudo）：
#   git clone https://github.com/NinaAWA/cnb-mcp-gateway.git && cd cnb-mcp-gateway && ./scripts/install-native.sh
# 随时重新打印连接信息：bash scripts/show-config.sh
# 验证：python3 scripts/selfcheck_v11.py（T01–T12 真实自检，仅适用于 Compose 部署）
# 注意：本文件只放占位/空值；.env 已被 .gitignore 排除，绝不提交凭据。
# MCP_TOKEN 与 ADMIN_PASSWORD 留空时由 entrypoint 首次启动生成强随机值，
# 分别保存到 /app/.env 与 /data/audit/.admin_password（均 600 权限、持久卷）。
# 注释必须单独一行，不要写在 = 后面（load_env() 不剥离行内注释）。

# ---------------- 镜像与升级 / 回滚 ----------------
# v1.1.0 制品；升级只需替换该标签，回滚把它改回上一个可用标签再 up -d。
MCP_IMAGE=ghcr.io/ninaawa/cnb-mcp-gateway-plus:v1.1.0
# 回滚锚点示例：MCP_IMAGE=ghcr.io/ninaawa/cnb-mcp-gateway-plus:v3.1.1

# ---------------- 鉴权（留空即自动生成） ----------------
# 留空 = 首次启动自动生成 48 位强随机令牌；也可填 openssl rand -hex 32 的输出
MCP_TOKEN=
# 只支持 OAuth 的客户端可用 OAuth 2.1 PKCE + DCR；Bearer 直连始终可用
MCP_OAUTH_REQUIRE_PKCE=1
# 位于可信反向代理之后才设为 1
MCP_TRUST_PROXY=0
ADMIN_TRUST_PROXY=0

# ---------------- 命令执行（默认管理员模式） ----------------
MCP_PORT=8765
# 容器内监听地址；宿主端口由 docker-compose.yml 只绑定到 127.0.0.1，公网入口用反代/隧道
MCP_BIND=0.0.0.0
MCP_WORKDIR=/workspace
# 留空 = 放行全部日常管理命令；仅需要收紧时才填（例如 git |python3 ）
MCP_ALLOWED_PREFIXES=
MCP_DENY_PREFIXES=
MCP_REQUIRE_CONFIRM=
MCP_MAX_OUTPUT_BYTES=2000000

# ---------------- 文件传输与长任务 ----------------
MCP_FILE_ROOT=/data/files
MCP_FILE_CHUNK_BYTES=1048576
MCP_TASK_LOG_DIR=/data/audit/task-logs
# 固定公网 HTTPS 基址（如 https://mcp.example.com）；download_file 返回的绝对链接以它为前缀。
# 留空时按本次请求的 scheme/Host 生成并标注 link_scope=local，不假装是公网地址。
MCP_PUBLIC_BASE_URL=
# 留空时回落到 MCP_TOKEN；网关与管理后台必须看到同一个值
MCP_FILE_SIGNING_SECRET=

# ---------------- Git ----------------
# 镜像内置 git-lfs 并完成系统级初始化；网关已放行 git lfs install/pull/checkout 等正常子操作
GIT_USER_NAME=your-git-username
GIT_USER_EMAIL=you@example.com
# 凭据文件建议以只读卷挂载，不要放进环境变量/命令参数/日志
GIT_CREDENTIALS_FILE=
MCP_GIT_EXTRA_SUBCOMMANDS=

# ---------------- Docker 宿主机授权（默认关闭） ----------------
# 0 = 不挂载 /var/run/docker.sock。设为 1 且叠加
# docker-compose.host-docker.yml 才生效；该权限等价于宿主机 root。
MCP_DOCKER_SOCKET=0
# 仅授权时生效：宿主机 docker CLI 路径（须为静态二进制），按 command -v docker 调整
MCP_HOST_DOCKER_CLI=/usr/local/bin/docker

# ---------------- 公网 HTTPS 入口 ----------------
# 默认关闭内置 quick tunnel：它每次重开都是随机域名，不是固定入口，还会把
# 默认管理员模式的服务直接暴露到公网。固定 HTTPS 请用 nginx 反代，或填
# CF_TUNNEL_TOKEN 并 `docker compose --profile tunnel up -d` 启动独立隧道容器。
CF_TUNNEL_TOKEN=
MCP_TUNNEL_DISABLED=1
MCP_UPSTREAM_URL=http://mcp-gateway:8765
# 可选：管理网站固定公网基址（如 https://admin.example.com），仅供 show-config.sh 打印；
# 留空则打印本机地址。公网入口仍需自行配置反代/隧道，本变量不会开放任何端口。
ADMIN_PUBLIC_BASE_URL=

# ---------------- 管理网站（独立认证） ----------------
ADMIN_USERNAME=admin
# 留空 = 首次启动随机生成并写入 600 权限持久文件；也可用强口令显式覆盖
# 读取（连同 MCP 地址、Bearer 令牌、客户端配置一起打印）：bash scripts/show-config.sh
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_TOTP_SECRET=
# 通过 HTTPS 反代访问后台时设为 1；本地 HTTP 一键部署必须为 0，
# 否则 Secure cookie 不会经 HTTP 回传，管理网站会一直 401。
ADMIN_COOKIE_SECURE=0
ADMIN_HOST_PORT=8788
ADMIN_BIND_HOST=127.0.0.1
MCP_PRINT_SECRETS=0

# ---------------- 审计存储 ----------------
AUDIT_DB_DSN=
AUDIT_STRICT=0
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_DB_MB=512
AUDIT_MAX_FIELD_CHARS=32768
AUDIT_BACKUP_ENABLED=1
AUDIT_BACKUP_KEEP=7
AUDIT_MAINTENANCE_INTERVAL=300
